# ── MemoryOps AI environment ─────────────────────────────────────────────────

# Deployment profile. "dev" (default) keeps demo-friendly defaults so the app
# runs with no infra. "production" is FAIL-CLOSED: the API refuses to start while
# storage is in-memory, auth is off, CORS is "*", the DSN uses demo/localhost
# credentials, or public evals are enabled. Only set this once every value below
# is production-safe. See docs/production-readiness.md.
MEMORYOPS_PROFILE=dev

# Auth adapter: none | trusted_header | jwt. "none" trusts caller-supplied scope
# (fine behind your own gateway); production rejects "none".
MEMORYOPS_AUTH_MODE=none

# CORS allow-list. "*" is fine for the demo but is rejected under the production
# profile. Comma-separated origins, e.g. https://app.example.com,https://admin.example.com
MEMORYOPS_CORS_ALLOW_ORIGINS=*

# Public eval trigger (denial-of-wallet risk if exposed). Keep false in production.
MEMORYOPS_PUBLIC_EVALS=false

# Storage backend for the API: "memory" (no infra) or "postgres"
MEMORYOPS_STORAGE=postgres

# Postgres (used when MEMORYOPS_STORAGE=postgres)
POSTGRES_USER=memoryops
POSTGRES_PASSWORD=memoryops
POSTGRES_DB=memoryops
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://memoryops:memoryops@db:5432/memoryops

# Redis (session/working memory cache; optional in Phase 1)
REDIS_URL=redis://redis:6379/0

# LLM provider adapter. Leave provider=heuristic to run with NO API keys.
# provider options: heuristic | openai | anthropic | gemini
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embeddings: "heuristic" (deterministic local hash) or "openai"
EMBEDDINGS_PROVIDER=heuristic
EMBEDDING_DIM=1536

# Observability
LOG_LEVEL=INFO
SERVICE_NAME=memoryops-api

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Web control plane (apps/web) ─────────────────────────────────────────────
# demo          → shared tenant_demo workspace, no authentication, visible banner.
#                 Public demo only; never the production control plane.
# authenticated → identity comes from the Auth.js session; the BFF derives
#                 tenant/user/role server-side and the browser cannot choose them.
# NOT NEXT_PUBLIC_*: authorization must not be decided by a value the browser can
# read or spoof. NEXT_PUBLIC_MEMORYOPS_WEB_MODE exists for the banner only.
MEMORYOPS_WEB_MODE=demo

# Auth.js session signing secret (authenticated mode). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Operators for the built-in Credentials provider, "tenant:user:role:password"
# comma-separated. This is the seam you replace with a real IdP (GitHub/Okta/
# Auth0) — see apps/web/auth.ts. Roles: viewer|developer|auditor|memory_admin|owner
MEMORYOPS_WEB_OPERATORS=acme:alice:owner:change-me

# Server-only upstream API base used by the BFF. Unlike NEXT_PUBLIC_API_URL this is
# never shipped to the browser, so no API credential is exposed client-side.
MEMORYOPS_API_URL=http://localhost:8000

# How the BFF authenticates to the API. Must match the API's MEMORYOPS_AUTH_MODE.
# jwt: the BFF mints a short-lived HS256 token per request using this key, which
# must equal the API's MEMORYOPS_AUTH_JWT_KEY.
MEMORYOPS_AUTH_JWT_KEY=
MEMORYOPS_API_TOKEN_TTL_SECONDS=120
